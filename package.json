{
  "name": "zhiqiang",
  "version": "1.0.0",
  "description": "知墙 · My-Memo-Boards——学生向便签墙学习工作台：考研/学期/待办/生活四区便签墙 + 作息侧栏 + 课程表浮窗（构成主义视觉）",
  "main": "main.js",
  "author": "Neutr0N_Star",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/Neutr0N_Star/zhiqiang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neutr0N_Star/zhiqiang.git"
  },
  "bugs": {
    "url": "https://github.com/Neutr0N_Star/zhiqiang/issues"
  },
  "keywords": [
    "学习",
    "便签",
    "考研",
    "效率",
    "Electron",
    "桌面"
  ],
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:store": "electron-builder --win appx",
    "dir": "electron-builder --dir"
  },
  "build": {
    "appId": "com.neutronstar.zhiqiang",
    "productName": "My-Memo-Boards",
    "asar": true,
    "npmRebuild": false,
    "icon": "assets/icon.ico",
    "copyright": "Copyright © 2026 Neutr0N_Star",
    "electronDownload": {
      "cache": ".builder-electron-cache",
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/icon.ico",
      "assets/logo.png",
      "LICENSE"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Neutr0N_Star",
        "repo": "zhiqiang"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "My-Memo-Boards-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "知墙",
      "artifactName": "My-Memo-Boards-${version}-setup.${ext}"
    },
    "appx": {
      "applicationId": "com.neutronstar.zhiqiang",
      "displayName": "知墙",
      "publisherDisplayName": "Neutr0N_Star",
      "artifactName": "My-Memo-Boards-${version}-store.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
