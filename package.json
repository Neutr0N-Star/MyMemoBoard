{
  "name": "xingzhijian",
  "version": "1.0.0",
  "description": "星之间 · 学习工作台：考研/学期/待办/生活四区便签墙 + 作息侧栏 + 课程表浮窗（构成主义视觉）",
  "main": "main.js",
  "author": "Neutr0N_Star",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dir": "electron-builder --dir"
  },
  "build": {
    "appId": "com.neutronstar.xingzhijian",
    "productName": "XingZhiJian",
    "asar": true,
    "npmRebuild": false,
    "icon": "assets/icon.ico",
    "copyright": "Copyright © 2026 Neutr0N_Star",
    "electronDownload": {
      "cache": ".builder-electron-cache",
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/icon.ico",
      "LICENSE"
    ],
    "win": {
      "target": ["portable"],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "XingZhiJian-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
